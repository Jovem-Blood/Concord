# Cloudflare Realtime SFU credentials are required, including in development.
# Create an SFU app in Cloudflare > Realtime > Serverless SFU.
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=
# Optional: keep the TURN key/API token server-side and generate short-lived ICE credentials.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
PORT=3001
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
PUBLIC_APP_URL=http://localhost:4173
PUBLIC_SERVER_URL=http://localhost:3001

# Optional OpenTelemetry. Empty endpoint = no export, no observability dependency.
# Accepts http/protobuf (default), http/json or grpc. Keep headers server-side.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=concord-server
OTEL_SERVICE_VERSION=1.0.0
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
# OTEL_SDK_DISABLED=true disables all signals even when an endpoint is configured.
# OTEL_TRACES_EXPORTER / OTEL_METRICS_EXPORTER / OTEL_LOGS_EXPORTER=none disables a signal.
# Signal-specific OTEL_EXPORTER_OTLP_{TRACES,METRICS,LOGS}_{ENDPOINT,PROTOCOL,HEADERS}
# override the common destination; HTTP signal endpoints include /v1/<signal>.

# Only needed for the optional docker-compose.observability.yml override.
# Choose a password before enabling it; do not commit it.
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
