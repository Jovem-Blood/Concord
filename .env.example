# Development defaults only. Replace every value in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:4173
PUBLIC_TOKEN_SERVER_URL=http://localhost:3001

# Optional managed relay. Configure both values together; never expose the API token to a client build.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL_SECONDS=7200
