  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.41.0",
    "vitest": "4.1.11"
  }
}
