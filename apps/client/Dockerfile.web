FROM node:24.7.0-alpine AS build
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY apps/client/package.json apps/client/package.json
RUN pnpm install --frozen-lockfile --filter @concord/client...

COPY apps/client apps/client
ARG VITE_SERVER_URL
ARG VITE_WEB_APP_URL
ENV VITE_SERVER_URL=$VITE_SERVER_URL
ENV VITE_WEB_APP_URL=$VITE_WEB_APP_URL
WORKDIR /app/apps/client
RUN node ../../node_modules/vite/bin/vite.js build --config vite.web.config.ts

FROM nginx:1.29-alpine AS runtime
COPY apps/client/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/client/dist-web /usr/share/nginx/html
EXPOSE 4173
