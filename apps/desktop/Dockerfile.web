FROM node:24.7.0-alpine AS build
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY apps/desktop/package.json apps/desktop/package.json
RUN pnpm install --frozen-lockfile --filter @concord/desktop...

COPY apps/desktop apps/desktop
ARG VITE_TOKEN_SERVER_URL
ARG VITE_WEB_APP_URL
ENV VITE_TOKEN_SERVER_URL=$VITE_TOKEN_SERVER_URL
ENV VITE_WEB_APP_URL=$VITE_WEB_APP_URL
WORKDIR /app/apps/desktop
RUN node ../../node_modules/vite/bin/vite.js build --config vite.web.config.ts

FROM nginx:1.29-alpine AS runtime
COPY apps/desktop/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/desktop/dist-web /usr/share/nginx/html
EXPOSE 4173
