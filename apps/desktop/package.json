{
  "name": "@concord/desktop",
  "productName": "Concord",
  "desktopName": "Concord",
  "version": "0.1.0",
  "description": "Private screen sharing for small groups",
  "author": "Concord Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jovem-Blood/Concord.git"
  },
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-forge start",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-forge package",
    "build:web": "vite build --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "package": "electron-forge package",
    "make": "node scripts/make-platform.mjs",
    "make:windows": "node scripts/make-platform.mjs win32",
    "make:linux": "node scripts/make-platform.mjs linux",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "9.34.0",
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/tsconfig": "0.8.1",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "9.34.0",
    "eslint-plugin-vue": "10.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.0.6"
  }
}
